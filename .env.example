# ── Model provider (pick one) ────────────────────────────────────────────────
# Groq — free tier, no card required. https://console.groq.com → API Keys
GROQ_API_KEY=
GROQ_SMALL_MODEL=llama-3.1-8b-instant
GROQ_LARGE_MODEL=llama-3.3-70b-versatile
# …or OpenAI if you have a paid account:
# OPENAI_API_KEY=

# ── Orkid ────────────────────────────────────────────────────────────────────
# Orkid API key (40-char hex). Needed for PRODUCTION solves and partner
# volume tracking / rebates. Sandbox route + dry-run solve are keyless.
# Self-serve: POST https://orkidlabs.xyz/api/v1/signup {"email": "...", "project": "..."}
# Partner tier: https://orkidlabs.xyz/partner or api@orkidlabs.com
ORKID_API_KEY=

# Orkid API base URL. Production: https://orkidlabs.xyz
# Sandbox: the literal string "sandbox" (or https://sandbox.orkidlabs.com)
ORKID_API_URL=https://orkidlabs.xyz

# Default user wallet address for swaps.
ORKID_USER_ADDRESS=

# ── MemPalace (optional) ─────────────────────────────────────────────────────
# MemPalace MCP command (stdio transport).
MEMPALACE_MCP_CMD=mempalace-mcp
# MemPalace HTTP URL (optional, takes precedence over MEMPALACE_MCP_CMD).
# MEMPALACE_MCP_URL=http://localhost:8765
# MemPalace data directory (optional).
MEMPALACE_DIR=/data/mempalace

# ── ElizaOS ──────────────────────────────────────────────────────────────────
# PgLite data directory.
PGLITE_DATA_DIR=./.eliza/.elizadb
